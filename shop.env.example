# Copy to shop.env beside your desktop data folder (see docs/LOCAL_DEPLOYMENT.md)
# Example: %APPDATA%\enterprise-pos\shop.env

# M-Pesa Daraja (sandbox)
MPESA_ENV=sandbox
MPESA_MOCK=false
MPESA_CONSUMER_KEY=your-sandbox-consumer-key
MPESA_CONSUMER_SECRET=your-sandbox-consumer-secret
MPESA_PASSKEY=your-sandbox-passkey
MPESA_SHORTCODE=174379

# Public callback (Worker relay or dev tunnel — not 127.0.0.1 for real STK)
MPESA_POS_CALLBACK_URL=https://your-relay.workers.dev/v1/mpesa/stk-callback?tenant=YOUR_BUSINESS_ID
MPESA_RELAY_URL=https://your-relay.workers.dev
MPESA_RELAY_TILL_TOKEN=your-long-random-token

# Gmail password reset (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your@gmail.com

# Optional receipt width (mm)
RECEIPT_WIDTH_MM=80
