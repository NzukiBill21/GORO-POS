DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-in-production-min-32-characters-long"
ENCRYPTION_KEY="change-this-encryption-key-32chars-min"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS="7"
PORT=3001
NODE_ENV=development
# Dev web only (Vite). Shop desktop uses SERVE_STATIC on API port — leave unset or use http://127.0.0.1:3001.
# Match Vite (vite.config host). Either localhost or 127.0.0.1 works in dev — both are accepted.
CORS_ORIGIN="http://127.0.0.1:5173"
BACKUP_DIR="./backups"
# Desktop till: local backups are AES-256-GCM `.gbak` files by default (ENCRYPTION_KEY from Electron secrets).
# BACKUP_ENCRYPT=false  # force plain .db (not recommended on shop PCs)

# Subscription billing automation
BILLING_CRON_ENABLED=true
BILLING_CRON_INTERVAL_MS=3600000
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-in-production"
# Optional HMAC for in-store POS STK callback (header x-gorovian-signature, sha256 hex)
# POS_WEBHOOK_SECRET=

# M-Pesa Daraja (leave blank + MPESA_MOCK=true for local dev without credentials)
MPESA_ENV=sandbox
MPESA_MOCK=true
MPESA_MOCK_DELAY_MS=4000
# Sandbox test MSISDN (Safaricom docs): 254708374149
# POS STK callback — must be public HTTPS for real STK (Worker relay or dev tunnel):
# MPESA_POS_CALLBACK_URL=https://your-relay.workers.dev/v1/mpesa/stk-callback?tenant=BUSINESS_UUID
# MPESA_RELAY_URL=https://your-relay.workers.dev
# MPESA_RELAY_TILL_TOKEN=long-random-token

# Packaged desktop: persistent DB outside OneDrive/install dir (uses prisma/pos.db inside this folder)
# GOROVIAN_DATA_DIR=C:\ProgramData\GorovianPOS
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://127.0.0.1:3001/api/billing/webhooks/mpesa

# Platform admin (seeded on db:seed)
PLATFORM_ADMIN_EMAIL=admin@gorovian.com
PLATFORM_ADMIN_PASSWORD=GorovianAdmin123!

# Gmail SMTP — password reset emails (backend only; use App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-full-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-full-gmail-address@gmail.com
# Optional display name in emails
# MAIL_APP_NAME=Goro POS
# Optional hosted reset link (desktop tills use 6-digit code on the shop PC instead)
# PASSWORD_RESET_BASE_URL=https://your-app.example.com
# Dev only: log reset code to server console when SMTP is configured
# PASSWORD_RESET_DEV_LOG=true

# Local shop installs: create staff with temp password (no SMTP). Platform may pass ownerInitialPassword when true.
# ALLOW_LOCAL_TENANT_PROVISION=true
# DESKTOP_MODE=true also enables local owner provisioning from platform API.

# Owner / staff invitations (platform-created tenants)
# INVITE_BASE_URL=https://pos.yourdomain.com
# PUBLIC_REGISTRATION_ENABLED=false
# Dev only — never true in production (logs invite codes server-side)
# REGISTRATION_DEV_LOG=true

# --- Centrally hosted production (one API + DB, many tenants; Windows uses browser) ---
# NODE_ENV=production
# SERVE_STATIC=true
# HOST=0.0.0.0
# DATABASE_URL=file:/var/lib/gorovian/pos.db
# CORS_ORIGIN=https://pos.yourdomain.com
# JWT_SECRET=<random 32+ chars>
# ENCRYPTION_KEY=<random 32+ chars>
# MPESA_MOCK=false
# MPESA_ENV=production
# BILLING_ENABLED=true
# Place TLS termination on nginx/Caddy/IIS in front of Node (HTTPS required for production)
# HOSTED_BACKUP_ENABLED=true
# HOSTED_BACKUP_RETAIN=14
# HOSTED_BACKUP_BUSINESS_ID=<optional audit row business id>
# Daily server-wide SQLite backups run when HOSTED_BACKUP_ENABLED=true or (SERVE_STATIC=true && NODE_ENV=production && DESKTOP_MODE is not true)
# Manual backup: npm run backup:server
